# KYLA environment — copy to .env (never commit .env). Everything here is OPTIONAL:
# missing values = that integration quietly stays off, nothing breaks.

# ---- Supabase (default backend: database + logins, free tier) ----
# Server side only (online bridge on your Mac / box, GitHub Actions secrets).
# tools/supabase_sink.py reads these from the environment or from this .env file.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key (legacy JWT, eyJ...) OR the new secret key (sb_secret_...). Bypasses RLS — keep private.
SUPABASE_SERVICE_ROLE_KEY=
# Public anon / publishable key — goes in web/config.js (or the UI Account panel), not needed server side.
SUPABASE_ANON_KEY=

# ---- Online bridge (tools/online_bridge.py) ----
KYLA_BRIDGE_HOST=127.0.0.1
KYLA_BRIDGE_PORT=8787
KYLA_DEFAULT_AGENT=ruflo
KYLA_BRIDGE_TIMEOUT=180

# ---- Local stack ----
KYLA_STACK_DIR=~/kyla-stack
KYLA_CLONE_HEAVY=0

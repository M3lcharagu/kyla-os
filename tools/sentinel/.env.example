# Sentinel loads this file only when it exists; setup preserves an existing .env.
# Add your own provider API key locally. Do not commit secrets.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional settings; valid providers are anthropic, openai, and gemini.
SENTINEL_PROVIDER=anthropic
SENTINEL_MODEL=
SENTINEL_KEEP_SCREENSHOTS=false
